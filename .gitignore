.venv/
__pycache__/
*.pyc
.DS_Store

# Proxies and the SQLite index live inside each footage folder, not here, but
# ignore them anyway in case a batch is ever symlinked in.
.analysis_cache/

# Generated timelines and grid-check audio. These are outputs — the project
# .toml plus a commit is what reproduces them.
*.fcpxml
*.wav

# Footage never belongs in git.
*.mp4
*.mov
*.mp3

# ...but reusable overlay assets do. They are small, they are needed on every
# machine, and re-deriving them from a source pack by hand is exactly the kind
# of step that gets lost. Exception must come after the rules above.
!assets/**/*.mp4
!assets/**/*.mov
!assets/fcpxml/*.xml

# Stock is the exception to the exception. The rule above exists for the
# location-pin overlay — one small file needed by every drone video. The Pexels
# cache is a different animal: 281 MB after a single long-form video, growing
# per video, in a public repo. `manifest.json` carries the Pexels id and URL of
# everything pulled, which is what actually makes a build reproducible; the
# bytes are re-fetchable from that. The trade is that a clip deleted by its
# photographer is gone, and the fix then is to screen a replacement.
assets/stock/**/*.mp4
assets/stock/**/*.jpg
!assets/stock/manifest.json
# ...but the end-screen sting is a brand asset, not per-video stock: one
# 0.4 MB clip reused by every video on both channels. Same argument the
# location pin gets in assets/README.md.
!assets/stock/videos/subscribe/*.mp4

# Brand backgrounds are the same argument again: a handful of small looping
# files used behind every drawn beat on both channels. The generated ones are
# reproducible from `core.backdrop`, but committing them means a checkout
# renders identically without anyone having to know that.
!assets/brand/**/*.mp4
# ...and the music library, for the same reason. These are stored trimmed and
# lossless on purpose — see core/music.py.
!assets/brand/**/*.wav

# Local credentials. Never committed.
.secrets/
.publish-serve/

# Press and official assets (game art, trailer stills, drawn ticker cards):
# third-party bytes, re-fetchable from the URLs in each folder's SOURCES.md,
# which is the committed record.
assets/stock/press/**
!assets/stock/press/**/
!assets/stock/press/**/SOURCES.md

# Working notes stay local: the per-build publish handoff, the old session
# handoff, and the performance review's experiment log and run history.
HANDOFF.md
HANDOFF-PUBLISH.md
.claude/skills/video-performance-review/experiments.md
.claude/skills/video-performance-review/history/
