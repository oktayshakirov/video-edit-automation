<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.10">
    <resources>
        <format id="r0" name="{{ fmt_name }}" frameDuration="{{ frame_duration }}" width="{{ width }}" height="{{ height }}" colorSpace="1-1-1 (Rec. 709)"/>
{% for a in video_assets %}
        <asset id="{{ a.id }}" name="{{ a.name }}" uid="{{ a.uid }}" start="0s" duration="{{ a.duration }}" hasVideo="1" format="r0" videoSources="1">
            <media-rep kind="original-media" src="{{ a.src }}"/>
        </asset>
{% endfor %}
{% for a in audio_assets %}
        <asset id="{{ a.id }}" name="{{ a.name }}" uid="{{ a.uid }}" start="0s" duration="{{ a.duration }}" hasAudio="1" audioSources="1" audioChannels="2" audioRate="{{ a.rate }}">
            <media-rep kind="original-media" src="{{ a.src }}"/>
        </asset>
{% endfor %}
{% if overlays %}
{# Every pin is the same red pin from the same file and every title uses the
   same generator, so these resources are emitted once and referenced by all of
   them. Repeating them per pin would offer Final Cut duplicate uids. #}
{% set p0 = overlays[0].pin %}
        <format id="{{ p0.format_id }}" name="FFVideoFormat1080p24" frameDuration="100/2400s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)"/>
        <asset id="{{ p0.asset_id }}" name="location-pin" uid="location-pin-red" start="0s" duration="54833/1000s" hasVideo="1" format="{{ p0.format_id }}" videoSources="1">
            <media-rep kind="original-media" src="{{ p0.src }}"/>
        </asset>
        {{ p0.effect | safe }}
{% for o in overlays %}
{% if o.title and loop.first %}
        {{ o.title.effect | safe }}
{% endif %}
{% endfor %}
{% endif %}
{% if lut_effect %}
        {{ lut_effect | safe }}
{% endif %}
{% for a in sfx_assets %}
        <asset id="{{ a.id }}" name="{{ a.name }}"{% if a.uid %} uid="{{ a.uid }}"{% endif %} start="0s" duration="{{ a.duration }}" hasAudio="1" audioSources="1" audioChannels="2" audioRate="{{ a.rate }}">
            <media-rep kind="original-media" src="{{ a.src }}"/>
        </asset>
{% endfor %}
    </resources>
    <library>
        <event name="{{ event_name }}">
            <project name="{{ project_name }}">
                <sequence format="r0" duration="{{ sequence_duration }}" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
{% for c in cuts %}
{# The overlay loop below needs this clip's index; inside that loop `loop`
   refers to the overlay iteration, not this one. #}
{% set ci = loop.index0 %}
                        <asset-clip ref="{{ c.ref }}" offset="{{ c.offset }}" name="{{ c.name }}" start="{{ c.start }}" duration="{{ c.duration }}" format="r0" tcFormat="NDF">
{% if c.timemap %}
                            <timeMap>
{% for p in c.timemap %}
                                <timept time="{{ p.time }}" value="{{ p.value }}" interp="{{ p.interp | default('linear') }}"/>
{% endfor %}
                            </timeMap>
{% endif %}
{% if c.lut %}
                            {{ c.lut | safe }}
{% endif %}
{% if c.fade %}
                            <adjust-blend amount="1">
                                <param name="amount">
                                    <keyframeAnimation>
                                        <keyframe time="{{ c.fade.from }}" value="1"/>
                                        <keyframe time="{{ c.fade.to }}" value="0"/>
                                    </keyframeAnimation>
                                </param>
                            </adjust-blend>
{% endif %}
{% if loop.first %}
{% for m in music_clips %}
                            <asset-clip ref="{{ m.id }}" lane="{{ m.lane }}" offset="{{ m.offset }}" name="{{ m.name }}" start="{{ m.start }}" duration="{{ m.duration }}" audioRole="music">
{% if m.volume %}
                                <adjust-volume amount="0dB">
                                    <param name="amount">
                                        <keyframeAnimation>
{% for k in m.volume %}
                                            <keyframe time="{{ k.time }}" value="{{ k.value }}"/>
{% endfor %}
                                        </keyframeAnimation>
                                    </param>
                                </adjust-volume>
{% endif %}
                            </asset-clip>
{% endfor %}
{% endif %}
{% for o in overlays if o.host == ci %}
                            {{ o.pin.clip | safe }}
{% if o.title %}
                            {{ o.title.clip | safe }}
{% endif %}
{% endfor %}
{% for f in c.sfx %}
                            <asset-clip ref="{{ f.ref }}" lane="{{ f.lane }}" offset="{{ f.offset }}" name="{{ f.name }}" start="{{ f.start }}" duration="{{ f.duration }}" audioRole="effects"/>
{% endfor %}
                        </asset-clip>
{% endfor %}
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
